<?xml version="1.0" encoding="utf-8"?>
<!--
    kIkI 접근성 서비스 설정.
    - typeWindowStateChanged       : IME 전환/시스템 팝업 감지 (Feature 1)
    - typeWindowsChanged           : 소프트 키보드(IME) 창 등장/소멸 감지 — 터치 키보드 제외(추가 기능 2)
    - typeViewTextSelectionChanged : 드래그 선택 감지 (Feature 4)
    - typeViewTextChanged          : 입력 실착 감지(편집칸에 글자가 들어감) — 포커스 경고 오발동 방지
    - flagRequestFilterKeyEvents   : onKeyEvent 수신 (Feature 3, 포커스 없는 키 입력)
    - canRequestFilterKeyEvents    : 키 이벤트 필터 권한 요청
    보안 원칙: 필요한 이벤트 타입만 등록, 텍스트 '내용'은 읽지 않고(편집 여부만), 키 이벤트는 절대 소비하지 않음.

    ⚠️ 이 XML 은 **최대 집합**이다. 실제 구독 이벤트/플래그는 서비스가 런타임에 `syncServiceInfo()` 로
    켜진 기능만큼만 좁힌다(저사양 최적화 — 예: 포커스 경고 OFF 면 키 필터·텍스트 변경 구독을 내리고,
    터치 키보드 제외 OFF 면 typeWindowsChanged/윈도우 추적을 내린다). `can*` 능력은 런타임에 다시 켜기
    위해 여기 남겨 둬야 한다. notificationTimeout 도 런타임에 100ms 로 조정된다.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowsChanged|typeViewTextSelectionChanged|typeViewTextChanged"
    android:accessibilityFeedbackType="feedbackVisual"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="50"
    android:settingsActivity="com.langsense.app.ui.SettingsActivity" />
