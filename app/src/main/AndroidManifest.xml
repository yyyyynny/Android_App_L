<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 필수 권한 (오버레이 표시). 접근성 서비스는 BIND_ACCESSIBILITY_SERVICE 를 service 선언에서
         android:permission 으로 요구하므로 uses-permission 이 아니다.
         ※ 포그라운드 서비스 권한(FOREGROUND_SERVICE / _SPECIAL_USE)은 선언하지 않는다 — 이 앱은
         startForeground 를 호출하는 서비스가 없다(접근성 서비스는 시스템이 바인드해 유지). 특히
         _SPECIAL_USE 는 Play 심사에서 별도 정당화 사유 제출 의무가 있어 미사용 선언은 반려 위험.
         배터리 최적화도 REQUEST_IGNORE_BATTERY_OPTIMIZATIONS(제한 권한) 없이 시스템 설정 화면만
         띄우므로(PermissionHelper) 선언하지 않는다. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LangSense"
        tools:targetApi="35">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            접근성 설정 화면의 톱니바퀴(설정)에서 시스템(다른 프로세스)이 직접 실행할 수 있도록
            exported=true. 민감한 동작이 없는 단순 설정 화면이다.
        -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:parentActivityName=".ui.MainActivity" />

        <!--
            접근성 서비스. BIND_ACCESSIBILITY_SERVICE 는 시스템이 바인딩 시 강제하는
            서명 권한이므로 <uses-permission> 이 아니라 service 의 android:permission 으로 선언한다.
        -->
        <service
            android:name=".service.LangSenseAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
